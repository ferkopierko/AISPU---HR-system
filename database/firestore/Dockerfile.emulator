FROM eclipse-temurin:21-jre-alpine
# Official emulator, version/checksum from firebase-tools downloadableEmulatorInfo.json.
ADD --checksum=sha256:9b6498b7f62714d67f48f59b3818883cd682dbcd46b9f59511de81c97bb5166c https://storage.googleapis.com/firebase-preview-drop/emulator/cloud-firestore-emulator-v1.22.0.jar /opt/firestore-emulator.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/opt/firestore-emulator.jar"]
CMD ["--host", "0.0.0.0", "--port", "8080", "--project_id", "demo-smartrecruit"]
