# Skopíruj ako .env a doplň hodnoty. Súbor .env sa NEcommituje.

# --- Lokálny SQL Server v Dockeri (Backend 1 pri `docker compose up`) ---
# Heslo musí mať aspoň 8 znakov, veľké aj malé písmeno a číslo.
MSSQL_SA_PASSWORD=Hr_Local_2026

# --- Azure SQL Database (Backend 1 pri spustení mimo Dockera cez npm run dev) ---
# Pre lokálny SQL Server v Dockeri: AZURE_SQL_HOST=localhost, AZURE_SQL_DATABASE=hr_main,
# AZURE_SQL_USER=sa, AZURE_SQL_PASSWORD=<MSSQL_SA_PASSWORD>, AZURE_SQL_TRUST_CERT=true
AZURE_SQL_HOST=<server>.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=<database>
AZURE_SQL_USER=<admin-login>
AZURE_SQL_PASSWORD=<heslo>

# --- MySQL (Backend 2, lokálny Docker kontajner) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hr_analysis
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=hr_app
MYSQL_PASSWORD=change-me

# --- Backend 1 (Node.js / Express) ---
BACKEND1_PORT=3001
CORS_ORIGIN=http://localhost:5173
# vygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<dlhy-nahodny-retazec>
NODE_ENV=development

# --- Backend 2 (Python / FastAPI) ---
# CORS_ORIGIN je spoločný (viac adries oddeľ čiarkou)
BACKEND2_PORT=8000
MAX_UPLOAD_MB=5

# --- Spojenie Backend 2 -> Backend 1 (odovzdanie CV a kontaktu po analýze) ---
# Rovnaká hodnota pre oba backendy. Vygeneruj:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bez nej sa CV neukladá (analýza funguje ďalej).
INTERNAL_API_KEY=<dlhy-nahodny-retazec>
# Adresa Backendu 1 pre Backend 2 mimo Dockera (v Dockeri ju nastaví docker-compose.yml)
BACKEND1_URL=http://localhost:3001
# Adresa Backendu 2 pre Backend 1 mimo Dockera – mazanie analýz CV (GDPR)
BACKEND2_URL=http://localhost:8000
# GDPR: prihlášky staršie ako toľko mesiacov sa raz denne zmažú (text pri súhlase sľubuje 6)
RETENTION_MONTHS=6
