# Skopíruj ako .env a doplň hodnoty. Súbor .env sa NEcommituje.

# --- Azure SQL Database (Backend 1) ---
AZURE_SQL_HOST=<server>.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=<database>
AZURE_SQL_USER=<admin-login>
AZURE_SQL_PASSWORD=<heslo>

# --- MySQL (Backend 2, lokálny Docker kontajner) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=hr_analysis
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=hr_app
MYSQL_PASSWORD=change-me

# --- Backend 1 (Node.js / Express) ---
BACKEND1_PORT=3001
CORS_ORIGIN=http://localhost:5173
# vygeneruj: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<dlhy-nahodny-retazec>
NODE_ENV=development

# --- Backend 2 (Python / FastAPI) ---
# CORS_ORIGIN je spoločný (viac adries oddeľ čiarkou)
BACKEND2_PORT=8000
MAX_UPLOAD_MB=5
