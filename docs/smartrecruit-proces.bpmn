      <sequenceFlow id="Flow_I5_I6" sourceRef="I5" targetRef="I6" />
      <sequenceFlow id="Flow_I6_I7" sourceRef="I6" targetRef="I7" />
      <sequenceFlow id="Flow_I7_I8" sourceRef="I7" targetRef="I8" />
      <sequenceFlow id="Flow_I8_SE" sourceRef="I8" targetRef="SE" />
    </subProcess>
    <serviceTask id="N4" name="Uložiť analýzu do MySQL">
      <documentation>MySQL (hr_analysis), tabuľka cv_analyses.</documentation>
      <incoming>Flow_SUB_N4</incoming>
      <outgoing>Flow_N4_N5</outgoing>
    </serviceTask>
    <serviceTask id="N5" name="Uložiť skóre zhody do MySQL">
      <documentation>MySQL (hr_analysis), tabuľka match_scores (história analýz).</documentation>
      <incoming>Flow_N4_N5</incoming>
      <outgoing>Flow_N5_N6</outgoing>
    </serviceTask>
    <serviceTask id="N6" name="Vrátiť výsledok aplikácii">
      <incoming>Flow_N5_N6</incoming>
      <outgoing>Flow_N6_W16</outgoing>
    </serviceTask>
    <serviceTask id="N7" name="Vrátiť chybu analýzy">
      <incoming>Flow_GW_N2_N7</incoming>
      <incoming>Flow_BE_N7</incoming>
      <outgoing>Flow_N7_W16</outgoing>
    </serviceTask>
    <boundaryEvent id="BE" name="CV sa nedá prečítať" attachedToRef="SUB">
      <outgoing>Flow_BE_N7</outgoing>
      <errorEventDefinition id="BE_ed" errorRef="Error_CV" />
    </boundaryEvent>
    <startEvent id="S_H" name="HR manažér posudzuje prihlášky">
