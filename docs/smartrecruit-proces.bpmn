    </exclusiveGateway>
    <userTask id="H14" name="Potvrdiť zmenu stavu v prehľade">
      <incoming>Flow_W27_H14</incoming>
      <outgoing>Flow_H14_E_H</outgoing>
    </userTask>
    <endEvent id="E_H" name="Prihláška vybavená">
      <incoming>Flow_H14_E_H</incoming>
