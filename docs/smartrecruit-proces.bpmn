<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SmartRecruit" targetNamespace="http://smartrecruit.example/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <error id="Error_CV" name="CV sa nedá prečítať" errorCode="CV_UNREADABLE" />
  <collaboration id="Collaboration_SmartRecruit">
    <participant id="Participant_Uchadzac" name="Uchádzač" processRef="Process_Uchadzac" />
    <participant id="Participant_System" name="SmartRecruit AI – HR systém" processRef="Process_System" />
    <messageFlow id="MsgFlow_1" name="Požiadavka na otvorenie aplikácie" sourceRef="A1" targetRef="S_W" />
    <messageFlow id="MsgFlow_2" name="Zoznam pozícií" sourceRef="W2" targetRef="A2" />
    <messageFlow id="MsgFlow_3" name="Výber pozície" sourceRef="A3" targetRef="W3" />
    <messageFlow id="MsgFlow_4" name="Detail pozície" sourceRef="W4" targetRef="A4" />
    <messageFlow id="MsgFlow_5" name="Prihlasovacie údaje" sourceRef="A10" targetRef="W9" />
    <messageFlow id="MsgFlow_6" name="Registračné údaje" sourceRef="A9" targetRef="W5" />
    <messageFlow id="MsgFlow_7" name="Prihláška s CV a súhlasom" sourceRef="A11" targetRef="W11" />
    <messageFlow id="MsgFlow_8" name="Skóre zhody a zručnosti" sourceRef="W17" targetRef="C_ok" />
    <messageFlow id="MsgFlow_9" name="Chybová hláška" sourceRef="Werr" targetRef="C_err" />
    <messageFlow id="MsgFlow_10" name="Požiadavka na odhlásenie" sourceRef="A13" targetRef="W18" />
    <messageFlow id="MsgFlow_11" name="Notifikácia o rozhodnutí" sourceRef="W27" targetRef="C_N" />
  </collaboration>
  <process id="Process_Uchadzac" name="Proces uchádzača" isExecutable="false">
    <startEvent id="S_A" name="Uchádzač hľadá prácu">
      <outgoing>Flow_S_A_A1</outgoing>
    </startEvent>
    <userTask id="A1" name="Otvoriť aplikáciu">
      <incoming>Flow_S_A_A1</incoming>
      <outgoing>Flow_A1_A2</outgoing>
    </userTask>
    <userTask id="A2" name="Prezrieť zoznam pozícií">
      <incoming>Flow_A1_A2</incoming>
      <outgoing>Flow_A2_A3</outgoing>
    </userTask>
    <userTask id="A3" name="Otvoriť detail pozície">
      <incoming>Flow_A2_A3</incoming>
      <outgoing>Flow_A3_A4</outgoing>
    </userTask>
    <userTask id="A4" name="Prečítať požiadavky pozície">
      <incoming>Flow_A3_A4</incoming>
      <outgoing>Flow_A4_A5</outgoing>
    </userTask>
    <userTask id="A5" name="Rozhodnúť sa pre prihlášku">
      <incoming>Flow_A4_A5</incoming>
      <outgoing>Flow_A5_GW_A5</outgoing>
    </userTask>
    <exclusiveGateway id="GW_A5" name="Prihlásiť sa na pozíciu?">
      <incoming>Flow_A5_GW_A5</incoming>
      <outgoing>Flow_GW_A5_E_A1</outgoing>
      <outgoing>Flow_GW_A5_GW_A7</outgoing>
    </exclusiveGateway>
    <endEvent id="E_A1" name="Uchádzač odišiel">
      <incoming>Flow_GW_A5_E_A1</incoming>
    </endEvent>
    <exclusiveGateway id="GW_A7" name="Je prihlásený?">
      <incoming>Flow_GW_A5_GW_A7</incoming>
      <outgoing>Flow_GW_A7_GW_A8</outgoing>
      <outgoing>Flow_GW_A7_GW_Am2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_A8" name="Má už účet?">
      <incoming>Flow_GW_A7_GW_A8</incoming>
      <outgoing>Flow_GW_A8_A8</outgoing>
      <outgoing>Flow_GW_A8_A10</outgoing>
    </exclusiveGateway>
    <userTask id="A8" name="Zaregistrovať sa">
      <incoming>Flow_GW_A8_A8</incoming>
      <outgoing>Flow_A8_A9</outgoing>
    </userTask>
    <userTask id="A9" name="Zadať e-mail a heslo (registrácia)">
      <incoming>Flow_A8_A9</incoming>
      <outgoing>Flow_A9_GW_Am</outgoing>
    </userTask>
    <userTask id="A10" name="Prihlásiť sa (e-mail a heslo)">
      <incoming>Flow_GW_A8_A10</incoming>
      <outgoing>Flow_A10_GW_Am</outgoing>
    </userTask>
    <exclusiveGateway id="GW_Am">
      <incoming>Flow_A9_GW_Am</incoming>
      <incoming>Flow_A10_GW_Am</incoming>
      <outgoing>Flow_GW_Am_GW_Am2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_Am2">
      <incoming>Flow_GW_A7_GW_Am2</incoming>
      <incoming>Flow_GW_Am_GW_Am2</incoming>
      <outgoing>Flow_GW_Am2_A6</outgoing>
    </exclusiveGateway>
    <userTask id="A6" name="Nahrať CV (PDF/DOCX, max. 5 MB)">
      <incoming>Flow_GW_Am2_A6</incoming>
      <outgoing>Flow_A6_A7</outgoing>
    </userTask>
    <userTask id="A7" name="Potvrdiť GDPR súhlas">
      <incoming>Flow_A6_A7</incoming>
      <outgoing>Flow_A7_A11</outgoing>
    </userTask>
    <sendTask id="A11" name="Odoslať prihlášku">
      <incoming>Flow_A7_A11</incoming>
      <outgoing>Flow_A11_GW_ev</outgoing>
    </sendTask>
    <eventBasedGateway id="GW_ev" name="Odpoveď systému">
      <incoming>Flow_A11_GW_ev</incoming>
      <outgoing>Flow_GW_ev_C_ok</outgoing>
      <outgoing>Flow_GW_ev_C_err</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="C_ok" name="Skóre zhody doručené">
      <incoming>Flow_GW_ev_C_ok</incoming>
      <outgoing>Flow_C_ok_A12</outgoing>
      <messageEventDefinition id="C_ok_ed" />
    </intermediateCatchEvent>
    <userTask id="A12" name="Zobraziť skóre zhody a zručnosti">
      <incoming>Flow_C_ok_A12</incoming>
      <outgoing>Flow_A12_A13</outgoing>
    </userTask>
    <userTask id="A13" name="Odhlásiť sa">
      <incoming>Flow_A12_A13</incoming>
      <outgoing>Flow_A13_C_N</outgoing>
    </userTask>
    <intermediateCatchEvent id="C_err" name="Chybová hláška doručená">
      <incoming>Flow_GW_ev_C_err</incoming>
      <outgoing>Flow_C_err_A12e</outgoing>
      <messageEventDefinition id="C_err_ed" />
    </intermediateCatchEvent>
    <userTask id="A12e" name="Prečítať chybu a prihlášku opraviť">
      <incoming>Flow_C_err_A12e</incoming>
      <outgoing>Flow_A12e_E_A2</outgoing>
    </userTask>
    <endEvent id="E_A2" name="Prihláška nedokončená">
      <incoming>Flow_A12e_E_A2</incoming>
    </endEvent>
    <intermediateCatchEvent id="C_N" name="Notifikácia o rozhodnutí">
      <incoming>Flow_A13_C_N</incoming>
      <outgoing>Flow_C_N_A14</outgoing>
      <messageEventDefinition id="C_N_ed" />
    </intermediateCatchEvent>
    <userTask id="A14" name="Zobraziť stav prihlášky">
      <incoming>Flow_C_N_A14</incoming>
      <outgoing>Flow_A14_E_A3</outgoing>
    </userTask>
    <endEvent id="E_A3" name="Proces uchádzača ukončený">
      <incoming>Flow_A14_E_A3</incoming>
    </endEvent>
    <sequenceFlow id="Flow_S_A_A1" sourceRef="S_A" targetRef="A1" />
    <sequenceFlow id="Flow_A1_A2" sourceRef="A1" targetRef="A2" />
    <sequenceFlow id="Flow_A2_A3" sourceRef="A2" targetRef="A3" />
    <sequenceFlow id="Flow_A3_A4" sourceRef="A3" targetRef="A4" />
    <sequenceFlow id="Flow_A4_A5" sourceRef="A4" targetRef="A5" />
    <sequenceFlow id="Flow_A5_GW_A5" sourceRef="A5" targetRef="GW_A5" />
    <sequenceFlow id="Flow_GW_A5_E_A1" name="Nie" sourceRef="GW_A5" targetRef="E_A1" />
    <sequenceFlow id="Flow_GW_A5_GW_A7" name="Áno" sourceRef="GW_A5" targetRef="GW_A7" />
    <sequenceFlow id="Flow_GW_A7_GW_A8" name="Nie" sourceRef="GW_A7" targetRef="GW_A8" />
    <sequenceFlow id="Flow_GW_A7_GW_Am2" name="Áno" sourceRef="GW_A7" targetRef="GW_Am2" />
    <sequenceFlow id="Flow_GW_A8_A8" name="Nie" sourceRef="GW_A8" targetRef="A8" />
    <sequenceFlow id="Flow_GW_A8_A10" name="Áno" sourceRef="GW_A8" targetRef="A10" />
    <sequenceFlow id="Flow_A8_A9" sourceRef="A8" targetRef="A9" />
    <sequenceFlow id="Flow_A9_GW_Am" sourceRef="A9" targetRef="GW_Am" />
    <sequenceFlow id="Flow_A10_GW_Am" sourceRef="A10" targetRef="GW_Am" />
    <sequenceFlow id="Flow_GW_Am_GW_Am2" sourceRef="GW_Am" targetRef="GW_Am2" />
    <sequenceFlow id="Flow_GW_Am2_A6" sourceRef="GW_Am2" targetRef="A6" />
    <sequenceFlow id="Flow_A6_A7" sourceRef="A6" targetRef="A7" />
    <sequenceFlow id="Flow_A7_A11" sourceRef="A7" targetRef="A11" />
    <sequenceFlow id="Flow_A11_GW_ev" sourceRef="A11" targetRef="GW_ev" />
    <sequenceFlow id="Flow_GW_ev_C_ok" sourceRef="GW_ev" targetRef="C_ok" />
    <sequenceFlow id="Flow_GW_ev_C_err" sourceRef="GW_ev" targetRef="C_err" />
    <sequenceFlow id="Flow_C_ok_A12" sourceRef="C_ok" targetRef="A12" />
    <sequenceFlow id="Flow_A12_A13" sourceRef="A12" targetRef="A13" />
    <sequenceFlow id="Flow_A13_C_N" sourceRef="A13" targetRef="C_N" />
    <sequenceFlow id="Flow_C_N_A14" sourceRef="C_N" targetRef="A14" />
    <sequenceFlow id="Flow_A14_E_A3" sourceRef="A14" targetRef="E_A3" />
    <sequenceFlow id="Flow_C_err_A12e" sourceRef="C_err" targetRef="A12e" />
    <sequenceFlow id="Flow_A12e_E_A2" sourceRef="A12e" targetRef="E_A2" />
  </process>
  <process id="Process_System" name="Proces HR systému" isExecutable="false">
    <laneSet id="LaneSet_System">
      <lane id="Lane_Web" name="Webová aplikácia (Frontend + Backend 1)">
        <flowNodeRef>S_W</flowNodeRef>
        <flowNodeRef>W1</flowNodeRef>
        <flowNodeRef>W2</flowNodeRef>
        <flowNodeRef>W3</flowNodeRef>
        <flowNodeRef>W4</flowNodeRef>
        <flowNodeRef>GW_W</flowNodeRef>
        <flowNodeRef>GW_W2</flowNodeRef>
        <flowNodeRef>W9</flowNodeRef>
        <flowNodeRef>W10</flowNodeRef>
        <flowNodeRef>W5</flowNodeRef>
        <flowNodeRef>W6</flowNodeRef>
        <flowNodeRef>W7</flowNodeRef>
        <flowNodeRef>W8</flowNodeRef>
        <flowNodeRef>GW_Wm</flowNodeRef>
        <flowNodeRef>GW_Wm2</flowNodeRef>
        <flowNodeRef>W11</flowNodeRef>
        <flowNodeRef>W12</flowNodeRef>
        <flowNodeRef>GW_W12</flowNodeRef>
        <flowNodeRef>W13</flowNodeRef>
        <flowNodeRef>GW_W13</flowNodeRef>
        <flowNodeRef>Wc</flowNodeRef>
        <flowNodeRef>W15</flowNodeRef>
        <flowNodeRef>W16</flowNodeRef>
        <flowNodeRef>GW_W16</flowNodeRef>
        <flowNodeRef>W17</flowNodeRef>
        <flowNodeRef>Werr</flowNodeRef>
        <flowNodeRef>E_Werr</flowNodeRef>
        <flowNodeRef>W18</flowNodeRef>
        <flowNodeRef>E_W</flowNodeRef>
        <flowNodeRef>W21</flowNodeRef>
        <flowNodeRef>W22</flowNodeRef>
        <flowNodeRef>W23</flowNodeRef>
        <flowNodeRef>W24</flowNodeRef>
        <flowNodeRef>W25</flowNodeRef>
        <flowNodeRef>W26</flowNodeRef>
        <flowNodeRef>W27</flowNodeRef>
      </lane>
      <lane id="Lane_Analyza" name="Analýza CV (Backend 2)">
        <flowNodeRef>N1</flowNodeRef>
        <flowNodeRef>N2</flowNodeRef>
        <flowNodeRef>GW_N2</flowNodeRef>
        <flowNodeRef>SUB</flowNodeRef>
        <flowNodeRef>N4</flowNodeRef>
        <flowNodeRef>N5</flowNodeRef>
        <flowNodeRef>N6</flowNodeRef>
        <flowNodeRef>N7</flowNodeRef>
        <flowNodeRef>BE</flowNodeRef>
      </lane>
      <lane id="Lane_HR" name="HR manažér">
        <flowNodeRef>S_H</flowNodeRef>
        <flowNodeRef>H1</flowNodeRef>
        <flowNodeRef>H2</flowNodeRef>
        <flowNodeRef>H3</flowNodeRef>
        <flowNodeRef>H4</flowNodeRef>
        <flowNodeRef>H5</flowNodeRef>
        <flowNodeRef>H6</flowNodeRef>
        <flowNodeRef>H7</flowNodeRef>
        <flowNodeRef>H8</flowNodeRef>
        <flowNodeRef>H9</flowNodeRef>
        <flowNodeRef>GW_H</flowNodeRef>
        <flowNodeRef>H10</flowNodeRef>
        <flowNodeRef>H11</flowNodeRef>
        <flowNodeRef>H12</flowNodeRef>
        <flowNodeRef>H13</flowNodeRef>
        <flowNodeRef>GW_Hm</flowNodeRef>
        <flowNodeRef>H14</flowNodeRef>
        <flowNodeRef>E_H</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S_W" name="Uchádzač otvoril aplikáciu">
      <outgoing>Flow_S_W_W1</outgoing>
      <messageEventDefinition id="S_W_ed" />
    </startEvent>
    <serviceTask id="W1" name="Načítať pozície z SQL">
      <documentation>GET /api/jobs – verejné, bez prihlásenia (tabuľka jobs, status open).</documentation>
      <incoming>Flow_S_W_W1</incoming>
      <outgoing>Flow_W1_W2</outgoing>
    </serviceTask>
    <serviceTask id="W2" name="Zobraziť zoznam pozícií">
      <incoming>Flow_W1_W2</incoming>
      <outgoing>Flow_W2_W3</outgoing>
    </serviceTask>
    <serviceTask id="W3" name="Načítať detail pozície">
      <documentation>GET /api/jobs/:id – verejné.</documentation>
      <incoming>Flow_W2_W3</incoming>
      <outgoing>Flow_W3_W4</outgoing>
    </serviceTask>
    <serviceTask id="W4" name="Zobraziť detail pozície">
      <incoming>Flow_W3_W4</incoming>
      <outgoing>Flow_W4_GW_W</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_W" name="Má uchádzač session?">
      <incoming>Flow_W4_GW_W</incoming>
      <outgoing>Flow_GW_W_GW_W2</outgoing>
      <outgoing>Flow_GW_W_GW_Wm2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_W2" name="Nový uchádzač?">
      <incoming>Flow_GW_W_GW_W2</incoming>
      <outgoing>Flow_GW_W2_W5</outgoing>
      <outgoing>Flow_GW_W2_W9</outgoing>
    </exclusiveGateway>
    <serviceTask id="W9" name="Overiť prihlasovacie údaje">
      <documentation>POST /api/auth/login – bcrypt porovnanie hesla.</documentation>
      <incoming>Flow_GW_W2_W9</incoming>
      <outgoing>Flow_W9_W10</outgoing>
    </serviceTask>
    <serviceTask id="W10" name="Vytvoriť session cookie (hr.sid)">
      <documentation>Nová session (regenerate) so zápisom userId a role.</documentation>
      <incoming>Flow_W9_W10</incoming>
      <outgoing>Flow_W10_GW_Wm</outgoing>
    </serviceTask>
    <serviceTask id="W5" name="Validovať údaje registrácie">
      <documentation>POST /api/auth/register – kontrola e-mailu a hesla.</documentation>
      <incoming>Flow_GW_W2_W5</incoming>
      <outgoing>Flow_W5_W6</outgoing>
    </serviceTask>
    <serviceTask id="W6" name="Zahashovať heslo">
      <documentation>bcrypt, 12 kôl.</documentation>
      <incoming>Flow_W5_W6</incoming>
      <outgoing>Flow_W6_W7</outgoing>
    </serviceTask>
    <serviceTask id="W7" name="Uložiť používateľa do SQL">
      <documentation>Tabuľka users, rola vždy „user“.</documentation>
      <incoming>Flow_W6_W7</incoming>
      <outgoing>Flow_W7_W8</outgoing>
    </serviceTask>
    <serviceTask id="W8" name="Vytvoriť session (automatické prihlásenie)">
      <documentation>Po registrácii je používateľ prihlásený hneď.</documentation>
      <incoming>Flow_W7_W8</incoming>
      <outgoing>Flow_W8_GW_Wm</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_Wm">
      <incoming>Flow_W8_GW_Wm</incoming>
      <incoming>Flow_W10_GW_Wm</incoming>
      <outgoing>Flow_GW_Wm_GW_Wm2</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_Wm2">
      <incoming>Flow_GW_W_GW_Wm2</incoming>
      <incoming>Flow_GW_Wm_GW_Wm2</incoming>
      <outgoing>Flow_GW_Wm2_W11</outgoing>
    </exclusiveGateway>
    <serviceTask id="W11" name="Skontrolovať session (requireAuth)">
      <documentation>POST /api/applications – bez session vráti 401.</documentation>
      <incoming>Flow_GW_Wm2_W11</incoming>
      <outgoing>Flow_W11_W12</outgoing>
    </serviceTask>
    <serviceTask id="W12" name="Skontrolovať, či je pozícia otvorená">
      <documentation>Pozícia musí mať status „open“, inak 404.</documentation>
      <incoming>Flow_W11_W12</incoming>
      <outgoing>Flow_W12_GW_W12</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_W12" name="Pozícia otvorená?">
      <incoming>Flow_W12_GW_W12</incoming>
      <outgoing>Flow_GW_W12_W13</outgoing>
      <outgoing>Flow_GW_W12_Werr</outgoing>
    </exclusiveGateway>
    <serviceTask id="W13" name="Vytvoriť záznam prihlášky">
      <documentation>INSERT do applications; UNIQUE (user_id, job_id).</documentation>
      <incoming>Flow_GW_W12_W13</incoming>
      <outgoing>Flow_W13_GW_W13</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_W13" name="Už prihlásený (409)?">
      <incoming>Flow_W13_GW_W13</incoming>
      <outgoing>Flow_GW_W13_Wc</outgoing>
      <outgoing>Flow_GW_W13_Werr</outgoing>
    </exclusiveGateway>
    <serviceTask id="Wc" name="Uložiť GDPR súhlas k prihláške">
      <documentation>Čas udelenia súhlasu sa ukladá k prihláške (applications.consent_at).</documentation>
      <incoming>Flow_GW_W13_Wc</incoming>
      <outgoing>Flow_Wc_W15</outgoing>
    </serviceTask>
    <sendTask id="W15" name="Odoslať CV a požiadavky do Backend 2">
      <documentation>POST /api/ml/analyze (multipart: file, application_id, requirements).</documentation>
      <incoming>Flow_Wc_W15</incoming>
      <outgoing>Flow_W15_N1</outgoing>
    </sendTask>
    <receiveTask id="W16" name="Prijať odpoveď Backend 2">
      <incoming>Flow_N6_W16</incoming>
      <incoming>Flow_N7_W16</incoming>
      <outgoing>Flow_W16_GW_W16</outgoing>
    </receiveTask>
    <exclusiveGateway id="GW_W16" name="Analýza úspešná?">
      <incoming>Flow_W16_GW_W16</incoming>
      <outgoing>Flow_GW_W16_W17</outgoing>
      <outgoing>Flow_GW_W16_Werr</outgoing>
    </exclusiveGateway>
    <serviceTask id="W17" name="Zobraziť skóre zhody uchádzačovi">
      <incoming>Flow_GW_W16_W17</incoming>
      <outgoing>Flow_W17_W18</outgoing>
    </serviceTask>
    <serviceTask id="Werr" name="Zobraziť chybovú hlášku uchádzačovi">
      <documentation>Prihláška ostane uložená bez skóre (HR uvidí „CV ešte nebolo analyzované“).</documentation>
      <incoming>Flow_GW_W12_Werr</incoming>
      <incoming>Flow_GW_W13_Werr</incoming>
      <incoming>Flow_GW_W16_Werr</incoming>
      <outgoing>Flow_Werr_E_Werr</outgoing>
    </serviceTask>
    <endEvent id="E_Werr" name="Chyba oznámená">
      <incoming>Flow_Werr_E_Werr</incoming>
    </endEvent>
    <serviceTask id="W18" name="Zrušiť session pri odhlásení">
      <documentation>POST /api/auth/logout – zruší session a vymaže cookie.</documentation>
      <incoming>Flow_W17_W18</incoming>
      <outgoing>Flow_W18_E_W</outgoing>
    </serviceTask>
    <endEvent id="E_W" name="Session ukončená">
      <incoming>Flow_W18_E_W</incoming>
    </endEvent>
    <serviceTask id="W21" name="Overiť prihlasovacie údaje HR">
      <documentation>Účet admina vytvára skript scripts/create-admin.js.</documentation>
      <incoming>Flow_H1_W21</incoming>
      <outgoing>Flow_W21_W22</outgoing>
    </serviceTask>
    <serviceTask id="W22" name="Vytvoriť session HR">
      <incoming>Flow_W21_W22</incoming>
      <outgoing>Flow_W22_W23</outgoing>
    </serviceTask>
    <serviceTask id="W23" name="Skontrolovať rolu admin (requireRole)">
      <documentation>Rolu kontroluje middleware pri každej požiadavke na /api/admin; inak 403.</documentation>
      <incoming>Flow_W22_W23</incoming>
      <outgoing>Flow_W23_H2</outgoing>
    </serviceTask>
    <serviceTask id="W24" name="Načítať prihlášky z SQL">
      <documentation>GET /api/admin/applications?status=&amp;jobId= (filtrovanie na serveri).</documentation>
      <incoming>Flow_H2_W24</incoming>
      <outgoing>Flow_W24_W25</outgoing>
    </serviceTask>
    <serviceTask id="W25" name="Pripojiť skóre z Backend 2">
      <documentation>GET /api/ml/results/:applicationId pre každú prihlášku.</documentation>
      <incoming>Flow_W24_W25</incoming>
      <outgoing>Flow_W25_H3</outgoing>
    </serviceTask>
    <serviceTask id="W26" name="Aktualizovať stav prihlášky v SQL">
      <documentation>PATCH /api/admin/applications/:id/status – reviewing, interview, accepted, rejected.</documentation>
      <incoming>Flow_GW_Hm_W26</incoming>
      <outgoing>Flow_W26_W27</outgoing>
    </serviceTask>
    <sendTask id="W27" name="Odoslať notifikáciu uchádzačovi">
      <incoming>Flow_W26_W27</incoming>
      <outgoing>Flow_W27_H14</outgoing>
    </sendTask>
    <serviceTask id="N1" name="Prijať požiadavku na analýzu">
      <incoming>Flow_W15_N1</incoming>
      <outgoing>Flow_N1_N2</outgoing>
    </serviceTask>
    <serviceTask id="N2" name="Validovať súbor (typ, max. 5 MB)">
      <documentation>413 – súbor &gt; 5 MB, 415 – nepodporovaný typ, 422 – prázdny alebo nečitateľný súbor.</documentation>
      <incoming>Flow_N1_N2</incoming>
      <outgoing>Flow_N2_GW_N2</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_N2" name="Súbor platný?">
      <incoming>Flow_N2_GW_N2</incoming>
      <outgoing>Flow_GW_N2_SUB</outgoing>
      <outgoing>Flow_GW_N2_N7</outgoing>
    </exclusiveGateway>
    <subProcess id="SUB" name="Analýza CV">
      <incoming>Flow_GW_N2_SUB</incoming>
      <outgoing>Flow_SUB_N4</outgoing>
      <startEvent id="SS" name="CV pripravené&#10; na analýzu">
        <outgoing>Flow_SS_I1</outgoing>
      </startEvent>
      <serviceTask id="I1" name="Extrahovať text z PDF / DOCX">
        <incoming>Flow_SS_I1</incoming>
        <outgoing>Flow_I1_I2</outgoing>
      </serviceTask>
      <serviceTask id="I2" name="Normalizovať text">
        <incoming>Flow_I1_I2</incoming>
        <outgoing>Flow_I2_I3</outgoing>
      </serviceTask>
      <serviceTask id="I3" name="Spracovať text cez spaCy (NLP)">
        <incoming>Flow_I2_I3</incoming>
        <outgoing>Flow_I3_I4</outgoing>
      </serviceTask>
      <serviceTask id="I4" name="Extrahovať zručnosti">
        <incoming>Flow_I3_I4</incoming>
        <outgoing>Flow_I4_I5</outgoing>
      </serviceTask>
      <serviceTask id="I5" name="Porovnať s požiadavkami pozície">
        <incoming>Flow_I4_I5</incoming>
        <outgoing>Flow_I5_I6</outgoing>
      </serviceTask>
      <serviceTask id="I6" name="Vypočítať pokrytie zručností">
        <incoming>Flow_I5_I6</incoming>
        <outgoing>Flow_I6_I7</outgoing>
      </serviceTask>
      <serviceTask id="I7" name="Vypočítať podobnosť textov">
        <incoming>Flow_I6_I7</incoming>
        <outgoing>Flow_I7_I8</outgoing>
      </serviceTask>
      <serviceTask id="I8" name="Vypočítať skóre zhody (0,6 × pokrytie + 0,4 × podobnosť)">
        <incoming>Flow_I7_I8</incoming>
        <outgoing>Flow_I8_SE</outgoing>
      </serviceTask>
      <endEvent id="SE" name="Skóre vypočítané">
        <incoming>Flow_I8_SE</incoming>
      </endEvent>
      <sequenceFlow id="Flow_SS_I1" sourceRef="SS" targetRef="I1" />
      <sequenceFlow id="Flow_I1_I2" sourceRef="I1" targetRef="I2" />
      <sequenceFlow id="Flow_I2_I3" sourceRef="I2" targetRef="I3" />
      <sequenceFlow id="Flow_I3_I4" sourceRef="I3" targetRef="I4" />
