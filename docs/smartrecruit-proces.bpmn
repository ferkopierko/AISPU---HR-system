<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_SmartRecruit" targetNamespace="http://smartrecruit.example/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <error id="Error_CV" name="CV sa nedá prečítať" errorCode="CV_UNREADABLE" />
  <collaboration id="Collaboration_SmartRecruit">
    <participant id="Participant_Uchadzac" name="Uchádzač" processRef="Process_Uchadzac" />
    <participant id="Participant_System" name="SmartRecruit AI – HR systém" processRef="Process_System" />
    <messageFlow id="MsgFlow_1" name="Požiadavka na otvorenie aplikácie" sourceRef="A1" targetRef="S_W" />
    <messageFlow id="MsgFlow_2" name="Registračné údaje" sourceRef="A3" targetRef="W2" />
    <messageFlow id="MsgFlow_3" name="Prihlasovacie údaje" sourceRef="A4" targetRef="W5" />
    <messageFlow id="MsgFlow_4" name="Zoznam pozícií" sourceRef="W9" targetRef="A5" />
    <messageFlow id="MsgFlow_5" name="Prihláška s CV a súhlasom" sourceRef="A11" targetRef="W10" />
    <messageFlow id="MsgFlow_6" name="Výsledok a skóre zhody" sourceRef="W14" targetRef="A12" />
    <messageFlow id="MsgFlow_7" name="Požiadavka na odhlásenie" sourceRef="A13" targetRef="W18" />
    <messageFlow id="MsgFlow_8" name="Rozhodnutie o prihláške" sourceRef="H14" targetRef="C_A" />
    <textAnnotation id="Note_HRLogin">
      <text>Prihlásenie HR používa rovnaké kroky ako prihlásenie uchádzača (overenie údajov, session, rola admin).</text>
    </textAnnotation>
    <association id="Assoc_HRLogin" associationDirection="None" sourceRef="H1" targetRef="Note_HRLogin" />
  </collaboration>
  <process id="Process_Uchadzac" name="Proces uchádzača" isExecutable="false">
    <startEvent id="S_A" name="Uchádzač chce podať prihlášku">
      <outgoing>Flow_S_A_A1</outgoing>
    </startEvent>
    <userTask id="A1" name="Otvoriť aplikáciu">
      <incoming>Flow_S_A_A1</incoming>
      <outgoing>Flow_A1_GW_A1</outgoing>
    </userTask>
    <exclusiveGateway id="GW_A1" name="Má už účet?">
      <incoming>Flow_A1_GW_A1</incoming>
      <outgoing>Flow_GW_A1_A2</outgoing>
      <outgoing>Flow_GW_A1_GW_A1m</outgoing>
    </exclusiveGateway>
    <userTask id="A2" name="Zaregistrovať sa">
      <incoming>Flow_GW_A1_A2</incoming>
      <outgoing>Flow_A2_A3</outgoing>
    </userTask>
    <userTask id="A3" name="Zadať e-mail a heslo">
      <incoming>Flow_A2_A3</incoming>
      <outgoing>Flow_A3_GW_A1m</outgoing>
    </userTask>
    <exclusiveGateway id="GW_A1m">
      <incoming>Flow_A3_GW_A1m</incoming>
      <incoming>Flow_GW_A1_GW_A1m</incoming>
      <outgoing>Flow_GW_A1m_A4</outgoing>
    </exclusiveGateway>
    <userTask id="A4" name="Prihlásiť sa">
      <incoming>Flow_GW_A1m_A4</incoming>
      <outgoing>Flow_A4_A5</outgoing>
    </userTask>
    <userTask id="A5" name="Prezrieť zoznam pozícií">
      <incoming>Flow_A4_A5</incoming>
      <outgoing>Flow_A5_A6</outgoing>
    </userTask>
    <userTask id="A6" name="Otvoriť detail pozície">
      <incoming>Flow_A5_A6</incoming>
      <outgoing>Flow_A6_A7</outgoing>
    </userTask>
    <userTask id="A7" name="Prečítať požiadavky pozície">
      <incoming>Flow_A6_A7</incoming>
      <outgoing>Flow_A7_A8</outgoing>
    </userTask>
    <userTask id="A8" name="Rozhodnúť sa pre prihlášku">
      <incoming>Flow_A7_A8</incoming>
      <outgoing>Flow_A8_GW_A8</outgoing>
    </userTask>
    <exclusiveGateway id="GW_A8" name="Prihlásiť sa na pozíciu?">
      <incoming>Flow_A8_GW_A8</incoming>
      <outgoing>Flow_GW_A8_E_A1</outgoing>
      <outgoing>Flow_GW_A8_A9</outgoing>
    </exclusiveGateway>
    <endEvent id="E_A1" name="Uchádzač odišiel">
      <incoming>Flow_GW_A8_E_A1</incoming>
    </endEvent>
    <userTask id="A9" name="Nahrať CV (PDF/DOCX, max. 5 MB)">
      <incoming>Flow_GW_A8_A9</incoming>
      <outgoing>Flow_A9_A10</outgoing>
    </userTask>
    <userTask id="A10" name="Potvrdiť GDPR súhlas">
      <incoming>Flow_A9_A10</incoming>
      <outgoing>Flow_A10_A11</outgoing>
    </userTask>
    <sendTask id="A11" name="Odoslať prihlášku">
      <incoming>Flow_A10_A11</incoming>
      <outgoing>Flow_A11_A12</outgoing>
    </sendTask>
    <userTask id="A12" name="Zobraziť skóre zhody a zručnosti">
      <incoming>Flow_A11_A12</incoming>
      <outgoing>Flow_A12_A13</outgoing>
    </userTask>
    <userTask id="A13" name="Odhlásiť sa">
      <incoming>Flow_A12_A13</incoming>
      <outgoing>Flow_A13_C_A</outgoing>
    </userTask>
    <intermediateCatchEvent id="C_A" name="Rozhodnutie o prihláške">
      <incoming>Flow_A13_C_A</incoming>
      <outgoing>Flow_C_A_E_A2</outgoing>
      <messageEventDefinition id="C_A_ed" />
    </intermediateCatchEvent>
    <endEvent id="E_A2" name="Proces uchádzača ukončený">
      <incoming>Flow_C_A_E_A2</incoming>
    </endEvent>
    <sequenceFlow id="Flow_S_A_A1" sourceRef="S_A" targetRef="A1" />
    <sequenceFlow id="Flow_A1_GW_A1" sourceRef="A1" targetRef="GW_A1" />
    <sequenceFlow id="Flow_GW_A1_A2" name="Nie" sourceRef="GW_A1" targetRef="A2" />
    <sequenceFlow id="Flow_A2_A3" sourceRef="A2" targetRef="A3" />
    <sequenceFlow id="Flow_A3_GW_A1m" sourceRef="A3" targetRef="GW_A1m" />
    <sequenceFlow id="Flow_GW_A1_GW_A1m" name="Áno" sourceRef="GW_A1" targetRef="GW_A1m" />
    <sequenceFlow id="Flow_GW_A1m_A4" sourceRef="GW_A1m" targetRef="A4" />
    <sequenceFlow id="Flow_A4_A5" sourceRef="A4" targetRef="A5" />
    <sequenceFlow id="Flow_A5_A6" sourceRef="A5" targetRef="A6" />
    <sequenceFlow id="Flow_A6_A7" sourceRef="A6" targetRef="A7" />
    <sequenceFlow id="Flow_A7_A8" sourceRef="A7" targetRef="A8" />
    <sequenceFlow id="Flow_A8_GW_A8" sourceRef="A8" targetRef="GW_A8" />
    <sequenceFlow id="Flow_GW_A8_E_A1" name="Nie" sourceRef="GW_A8" targetRef="E_A1" />
    <sequenceFlow id="Flow_GW_A8_A9" name="Áno" sourceRef="GW_A8" targetRef="A9" />
    <sequenceFlow id="Flow_A9_A10" sourceRef="A9" targetRef="A10" />
    <sequenceFlow id="Flow_A10_A11" sourceRef="A10" targetRef="A11" />
    <sequenceFlow id="Flow_A11_A12" sourceRef="A11" targetRef="A12" />
    <sequenceFlow id="Flow_A12_A13" sourceRef="A12" targetRef="A13" />
    <sequenceFlow id="Flow_A13_C_A" sourceRef="A13" targetRef="C_A" />
    <sequenceFlow id="Flow_C_A_E_A2" sourceRef="C_A" targetRef="E_A2" />
  </process>
  <process id="Process_System" name="Proces HR systému" isExecutable="false">
    <laneSet id="LaneSet_System">
      <lane id="Lane_Web" name="Webová aplikácia (Frontend + Backend 1)">
        <flowNodeRef>S_W</flowNodeRef>
        <flowNodeRef>W1</flowNodeRef>
        <flowNodeRef>GW_W1</flowNodeRef>
        <flowNodeRef>W2</flowNodeRef>
        <flowNodeRef>W3</flowNodeRef>
        <flowNodeRef>W4</flowNodeRef>
        <flowNodeRef>GW_W1m</flowNodeRef>
        <flowNodeRef>W5</flowNodeRef>
        <flowNodeRef>W6</flowNodeRef>
        <flowNodeRef>W7</flowNodeRef>
        <flowNodeRef>W8</flowNodeRef>
        <flowNodeRef>W9</flowNodeRef>
        <flowNodeRef>W10</flowNodeRef>
        <flowNodeRef>GW_W10</flowNodeRef>
        <flowNodeRef>W11</flowNodeRef>
        <flowNodeRef>W12</flowNodeRef>
        <flowNodeRef>W13</flowNodeRef>
        <flowNodeRef>W14</flowNodeRef>
        <flowNodeRef>W18</flowNodeRef>
        <flowNodeRef>E_W</flowNodeRef>
        <flowNodeRef>W15</flowNodeRef>
        <flowNodeRef>W16</flowNodeRef>
        <flowNodeRef>W17</flowNodeRef>
      </lane>
      <lane id="Lane_Analyza" name="Analýza CV (Backend 2)">
        <flowNodeRef>N1</flowNodeRef>
        <flowNodeRef>N2</flowNodeRef>
        <flowNodeRef>GW_N2</flowNodeRef>
        <flowNodeRef>SUB</flowNodeRef>
        <flowNodeRef>N4</flowNodeRef>
        <flowNodeRef>N5</flowNodeRef>
        <flowNodeRef>N6</flowNodeRef>
        <flowNodeRef>N7</flowNodeRef>
        <flowNodeRef>BE</flowNodeRef>
      </lane>
      <lane id="Lane_HR" name="HR manažér">
        <flowNodeRef>S_H</flowNodeRef>
        <flowNodeRef>H1</flowNodeRef>
        <flowNodeRef>H2</flowNodeRef>
        <flowNodeRef>H3</flowNodeRef>
        <flowNodeRef>H4</flowNodeRef>
        <flowNodeRef>H5</flowNodeRef>
        <flowNodeRef>H6</flowNodeRef>
        <flowNodeRef>H7</flowNodeRef>
        <flowNodeRef>H8</flowNodeRef>
        <flowNodeRef>H9</flowNodeRef>
        <flowNodeRef>GW_H</flowNodeRef>
        <flowNodeRef>H10</flowNodeRef>
        <flowNodeRef>H11</flowNodeRef>
        <flowNodeRef>H12</flowNodeRef>
        <flowNodeRef>H13</flowNodeRef>
        <flowNodeRef>GW_Hm</flowNodeRef>
        <flowNodeRef>H14</flowNodeRef>
        <flowNodeRef>E_H</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="S_W" name="Uchádzač otvoril aplikáciu">
      <outgoing>Flow_S_W_W1</outgoing>
      <messageEventDefinition id="S_W_ed" />
    </startEvent>
    <serviceTask id="W1" name="Zobraziť prihlásenie a registráciu">
      <incoming>Flow_S_W_W1</incoming>
      <outgoing>Flow_W1_GW_W1</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_W1" name="Nový uchádzač?">
      <incoming>Flow_W1_GW_W1</incoming>
      <outgoing>Flow_GW_W1_W2</outgoing>
      <outgoing>Flow_GW_W1_GW_W1m</outgoing>
    </exclusiveGateway>
    <serviceTask id="W2" name="Validovať údaje registrácie">
      <documentation>Backend 1: kontrola formátu e-mailu a sily hesla; registrácia vždy vytvorí rolu uchádzač.</documentation>
      <incoming>Flow_GW_W1_W2</incoming>
      <outgoing>Flow_W2_W3</outgoing>
    </serviceTask>
    <serviceTask id="W3" name="Zahashovať heslo">
      <documentation>bcrypt hash hesla.</documentation>
      <incoming>Flow_W2_W3</incoming>
      <outgoing>Flow_W3_W4</outgoing>
    </serviceTask>
    <serviceTask id="W4" name="Uložiť používateľa do SQL">
      <documentation>SQL Server (hr_main), tabuľka users.</documentation>
      <incoming>Flow_W3_W4</incoming>
      <outgoing>Flow_W4_GW_W1m</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_W1m">
      <incoming>Flow_W4_GW_W1m</incoming>
      <incoming>Flow_GW_W1_GW_W1m</incoming>
      <outgoing>Flow_GW_W1m_W5</outgoing>
    </exclusiveGateway>
    <serviceTask id="W5" name="Overiť prihlasovacie údaje">
      <documentation>Rovnaký postup (W5–W7) platí aj pre prihlásenie HR manažéra.</documentation>
      <incoming>Flow_GW_W1m_W5</incoming>
      <outgoing>Flow_W5_W6</outgoing>
    </serviceTask>
    <serviceTask id="W6" name="Vytvoriť session cookie">
      <incoming>Flow_W5_W6</incoming>
      <outgoing>Flow_W6_W7</outgoing>
    </serviceTask>
    <serviceTask id="W7" name="Skontrolovať rolu (user / admin)">
      <incoming>Flow_W6_W7</incoming>
      <outgoing>Flow_W7_W8</outgoing>
    </serviceTask>
    <serviceTask id="W8" name="Načítať pozície z SQL">
      <documentation>Tabuľka jobs v SQL Serveri.</documentation>
      <incoming>Flow_W7_W8</incoming>
      <outgoing>Flow_W8_W9</outgoing>
    </serviceTask>
    <serviceTask id="W9" name="Zobraziť pozície a detail pozície">
      <incoming>Flow_W8_W9</incoming>
      <outgoing>Flow_W9_W10</outgoing>
    </serviceTask>
    <serviceTask id="W10" name="Skontrolovať duplicitnú prihlášku">
      <documentation>Jeden účet sa môže na jednu pozíciu prihlásiť iba raz (UNIQUE user_id, job_id).</documentation>
      <incoming>Flow_W9_W10</incoming>
      <outgoing>Flow_W10_GW_W10</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_W10" name="Už prihlásený na pozíciu?">
      <incoming>Flow_W10_GW_W10</incoming>
      <outgoing>Flow_GW_W10_W11</outgoing>
      <outgoing>Flow_GW_W10_W14</outgoing>
    </exclusiveGateway>
    <serviceTask id="W11" name="Vytvoriť záznam prihlášky">
      <documentation>Tabuľka applications, stav „submitted“.</documentation>
      <incoming>Flow_GW_W10_W11</incoming>
      <outgoing>Flow_W11_W12</outgoing>
    </serviceTask>
    <sendTask id="W12" name="Odoslať CV a požiadavky do Backend 2">
      <incoming>Flow_W11_W12</incoming>
      <outgoing>Flow_W12_N1</outgoing>
    </sendTask>
    <receiveTask id="W13" name="Prijať výsledok analýzy">
      <incoming>Flow_N6_W13</incoming>
      <incoming>Flow_N7_W13</incoming>
      <outgoing>Flow_W13_W14</outgoing>
    </receiveTask>
    <serviceTask id="W14" name="Zobraziť výsledok uchádzačovi">
      <incoming>Flow_GW_W10_W14</incoming>
      <incoming>Flow_W13_W14</incoming>
      <outgoing>Flow_W14_W18</outgoing>
    </serviceTask>
    <serviceTask id="W18" name="Zrušiť session pri odhlásení">
      <incoming>Flow_W14_W18</incoming>
      <outgoing>Flow_W18_E_W</outgoing>
    </serviceTask>
    <endEvent id="E_W" name="Session ukončená">
      <incoming>Flow_W18_E_W</incoming>
    </endEvent>
    <serviceTask id="W15" name="Načítať prihlášky pre HR">
      <incoming>Flow_H2_W15</incoming>
      <outgoing>Flow_W15_W16</outgoing>
    </serviceTask>
    <serviceTask id="W16" name="Pripojiť skóre z Backend 2">
      <incoming>Flow_W15_W16</incoming>
      <outgoing>Flow_W16_H3</outgoing>
    </serviceTask>
    <serviceTask id="W17" name="Aktualizovať stav prihlášky v SQL">
      <documentation>Stavy: submitted, reviewing, interview, accepted, rejected.</documentation>
      <incoming>Flow_GW_Hm_W17</incoming>
      <outgoing>Flow_W17_H14</outgoing>
    </serviceTask>
    <serviceTask id="N1" name="Prijať požiadavku na analýzu">
      <incoming>Flow_W12_N1</incoming>
      <outgoing>Flow_N1_N2</outgoing>
    </serviceTask>
    <serviceTask id="N2" name="Validovať súbor (typ, max. 5 MB)">
      <incoming>Flow_N1_N2</incoming>
      <outgoing>Flow_N2_GW_N2</outgoing>
    </serviceTask>
    <exclusiveGateway id="GW_N2" name="Súbor platný?">
      <incoming>Flow_N2_GW_N2</incoming>
      <outgoing>Flow_GW_N2_SUB</outgoing>
      <outgoing>Flow_GW_N2_N7</outgoing>
    </exclusiveGateway>
    <subProcess id="SUB" name="Analýza CV">
      <incoming>Flow_GW_N2_SUB</incoming>
      <outgoing>Flow_SUB_N4</outgoing>
      <startEvent id="SS" name="CV pripravené&#10;na analýzu">
        <outgoing>Flow_SS_I1</outgoing>
      </startEvent>
      <serviceTask id="I1" name="Extrahovať text z PDF / DOCX">
        <incoming>Flow_SS_I1</incoming>
        <outgoing>Flow_I1_I2</outgoing>
      </serviceTask>
      <serviceTask id="I2" name="Normalizovať text">
        <incoming>Flow_I1_I2</incoming>
        <outgoing>Flow_I2_I3</outgoing>
      </serviceTask>
      <serviceTask id="I3" name="Spracovať text cez spaCy (NLP)">
        <incoming>Flow_I2_I3</incoming>
        <outgoing>Flow_I3_I4</outgoing>
      </serviceTask>
      <serviceTask id="I4" name="Extrahovať zručnosti">
        <incoming>Flow_I3_I4</incoming>
        <outgoing>Flow_I4_I5</outgoing>
      </serviceTask>
      <serviceTask id="I5" name="Porovnať s požiadavkami pozície">
        <incoming>Flow_I4_I5</incoming>
        <outgoing>Flow_I5_I6</outgoing>
      </serviceTask>
      <serviceTask id="I6" name="Vypočítať pokrytie zručností">
        <incoming>Flow_I5_I6</incoming>
        <outgoing>Flow_I6_I7</outgoing>
      </serviceTask>
      <serviceTask id="I7" name="Vypočítať podobnosť textov">
        <incoming>Flow_I6_I7</incoming>
        <outgoing>Flow_I7_I8</outgoing>
      </serviceTask>
      <serviceTask id="I8" name="Vypočítať skóre zhody (0,6 × pokrytie + 0,4 × podobnosť)">
        <incoming>Flow_I7_I8</incoming>
        <outgoing>Flow_I8_SE</outgoing>
      </serviceTask>
      <endEvent id="SE" name="Skóre&#10;vypočítané">
        <incoming>Flow_I8_SE</incoming>
      </endEvent>
      <sequenceFlow id="Flow_SS_I1" sourceRef="SS" targetRef="I1" />
      <sequenceFlow id="Flow_I1_I2" sourceRef="I1" targetRef="I2" />
      <sequenceFlow id="Flow_I2_I3" sourceRef="I2" targetRef="I3" />
      <sequenceFlow id="Flow_I3_I4" sourceRef="I3" targetRef="I4" />
      <sequenceFlow id="Flow_I4_I5" sourceRef="I4" targetRef="I5" />
      <sequenceFlow id="Flow_I5_I6" sourceRef="I5" targetRef="I6" />
      <sequenceFlow id="Flow_I6_I7" sourceRef="I6" targetRef="I7" />
      <sequenceFlow id="Flow_I7_I8" sourceRef="I7" targetRef="I8" />
      <sequenceFlow id="Flow_I8_SE" sourceRef="I8" targetRef="SE" />
    </subProcess>
    <serviceTask id="N4" name="Uložiť analýzu do MySQL">
      <documentation>MySQL (hr_analysis), tabuľka cv_analyses.</documentation>
      <incoming>Flow_SUB_N4</incoming>
      <outgoing>Flow_N4_N5</outgoing>
    </serviceTask>
    <serviceTask id="N5" name="Uložiť skóre zhody do MySQL">
      <documentation>MySQL (hr_analysis), tabuľka match_scores.</documentation>
      <incoming>Flow_N4_N5</incoming>
      <outgoing>Flow_N5_N6</outgoing>
    </serviceTask>
    <serviceTask id="N6" name="Vrátiť výsledok aplikácii">
      <incoming>Flow_N5_N6</incoming>
      <outgoing>Flow_N6_W13</outgoing>
    </serviceTask>
    <serviceTask id="N7" name="Vrátiť chybu analýzy">
      <incoming>Flow_GW_N2_N7</incoming>
      <incoming>Flow_BE_N7</incoming>
      <outgoing>Flow_N7_W13</outgoing>
    </serviceTask>
    <boundaryEvent id="BE" name="CV sa nedá prečítať" attachedToRef="SUB">
      <outgoing>Flow_BE_N7</outgoing>
      <errorEventDefinition id="BE_ed" errorRef="Error_CV" />
    </boundaryEvent>
    <startEvent id="S_H" name="HR manažér posudzuje prihlášky">
      <outgoing>Flow_S_H_H1</outgoing>
    </startEvent>
    <userTask id="H1" name="Prihlásiť sa ako HR manažér">
      <incoming>Flow_S_H_H1</incoming>
      <outgoing>Flow_H1_H2</outgoing>
    </userTask>
    <userTask id="H2" name="Otvoriť HR prehľad">
      <incoming>Flow_H1_H2</incoming>
      <outgoing>Flow_H2_W15</outgoing>
    </userTask>
    <userTask id="H3" name="Zobraziť zoznam prihlášok">
      <incoming>Flow_W16_H3</incoming>
      <outgoing>Flow_H3_H4</outgoing>
    </userTask>
    <userTask id="H4" name="Filtrovať podľa pozície">
      <incoming>Flow_H3_H4</incoming>
      <outgoing>Flow_H4_H5</outgoing>
    </userTask>
    <userTask id="H5" name="Zoradiť podľa skóre zhody">
      <incoming>Flow_H4_H5</incoming>
      <outgoing>Flow_H5_H6</outgoing>
    </userTask>
    <userTask id="H6" name="Otvoriť detail prihlášky">
      <incoming>Flow_H5_H6</incoming>
      <outgoing>Flow_H6_H7</outgoing>
    </userTask>
    <userTask id="H7" name="Skontrolovať splnené a chýbajúce zručnosti">
      <incoming>Flow_H6_H7</incoming>
      <outgoing>Flow_H7_H8</outgoing>
    </userTask>
    <userTask id="H8" name="Prezrieť CV uchádzača">
      <incoming>Flow_H7_H8</incoming>
      <outgoing>Flow_H8_H9</outgoing>
    </userTask>
    <userTask id="H9" name="Rozhodnúť o kandidátovi">
      <incoming>Flow_H8_H9</incoming>
      <outgoing>Flow_H9_GW_H</outgoing>
    </userTask>
    <exclusiveGateway id="GW_H">
      <incoming>Flow_H9_GW_H</incoming>
      <outgoing>Flow_GW_H_H10</outgoing>
      <outgoing>Flow_GW_H_H11</outgoing>
      <outgoing>Flow_GW_H_H12</outgoing>
