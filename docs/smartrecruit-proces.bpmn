    <userTask id="H10" name="Nastaviť stav „reviewing“">
      <incoming>Flow_GW_H_H10</incoming>
      <outgoing>Flow_H10_GW_Hm</outgoing>
    </userTask>
    <userTask id="H11" name="Pozvať na pohovor („interview“)">
      <incoming>Flow_GW_H_H11</incoming>
      <outgoing>Flow_H11_GW_Hm</outgoing>
    </userTask>
    <userTask id="H12" name="Prijať kandidáta („accepted“)">
      <incoming>Flow_GW_H_H12</incoming>
      <outgoing>Flow_H12_GW_Hm</outgoing>
    </userTask>
    <userTask id="H13" name="Zamietnuť kandidáta („rejected“)">
      <incoming>Flow_GW_H_H13</incoming>
      <outgoing>Flow_H13_GW_Hm</outgoing>
    </userTask>
    <exclusiveGateway id="GW_Hm">
      <incoming>Flow_H10_GW_Hm</incoming>
      <incoming>Flow_H11_GW_Hm</incoming>
      <incoming>Flow_H12_GW_Hm</incoming>
      <incoming>Flow_H13_GW_Hm</incoming>
